{
  "version": "1.3.2",
  "cases": [
    {
      "args": ["-h"],
      "stdout_contains": "Usage: duration",
      "stderr": "",
      "exit": 0
    },
    {
      "args": ["-v"],
      "stdout": "1.3.2\n",
      "stderr": "",
      "exit": 0
    },
    {
      "args": ["3600", "54000"],
      "stdout": "3s 600ms\n54s\n",
      "stderr": "",
      "exit": 0
    },
    {
      "args": ["-m", "3600"],
      "stdout": "3 secs 600 ms\n",
      "stderr": "",
      "exit": 0
    },
    {
      "args": ["-l", "--unit=s", "3600"],
      "stdout": "1 hour\n",
      "stderr": "",
      "exit": 0
    },
    {
      "args": ["-s", "-500"],
      "stdout": "500ms ago\n",
      "stderr": "",
      "exit": 0
    },
    {
      "args": ["-s", "-m", "1000", "2000"],
      "stdout": "1s\n2s\n1 sec\n2 secs\n",
      "stderr": "",
      "exit": 0
    },
    {
      "args": ["0"],
      "stdout": "0\n",
      "stderr": "",
      "exit": 0
    },
    {
      "args": ["--json", "1000"],
      "stdout_json": {
        "milliseconds": 1000,
        "seconds": 1,
        "minutes": 0.016666666666666666,
        "hours": 0.0002777777777777778,
        "days": 0.000011574074074074073
      },
      "stderr": "",
      "exit": 0
    },
    {
      "args": ["--json", "-500"],
      "stdout_json": {
        "milliseconds": -500,
        "seconds": -0.5,
        "minutes": -0.008333333333333333,
        "hours": -0.0001388888888888889,
        "days": -0.000005787037037037037
      },
      "stderr": "",
      "exit": 0
    },
    {
      "args": ["--table", "1000", "2000"],
      "stdout": "+---------------------------------------------------------------------------------------------------------------------------------+\n| milliseconds            | seconds                 | minutes                 | hours                   | days                    |\n+=================================================================================================================================+\n| 1000                    | 1                       | 0.016666666666666666    | 0.0002777777777777778   | 0.000011574074074074073 |\n| 2000                    | 2                       | 0.03333333333333333     | 0.0005555555555555556   | 0.000023148148148148147 |\n+---------------------------------------------------------------------------------------------------------------------------------+\n",
      "stderr": "",
      "exit": 0,
      "skip_shell": true
    },
    {
      "args": [],
      "stderr_contains": "provide a duration value",
      "exit": 1
    },
    {
      "args": ["abc"],
      "stderr_contains": "provide a number",
      "exit": 1
    },
    {
      "args": ["60"],
      "env": { "DURATION_UNIT": "s" },
      "stdout": "1m\n",
      "stderr": "",
      "exit": 0
    }
  ]
}
